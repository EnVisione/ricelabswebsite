{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/:path((?!assets|og-image\\.jpg|favicon\\.svg|manifest\\.webmanifest|robots\\.txt|sitemap\\.xml|icons\\.svg).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
